# Training-side image: the retrain worker (PyTorch CPU) that registers new versions and asks the
# API to activate them. Shares the registry volume with the serving container.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    METRONOME_REGISTRY=/registry \
    METRONOME_API_URL=http://api:8000

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ".[train,export]"

# Non-root, same uid/gid as the serving image (see Dockerfile). /app/data is where `metronome prepare` writes.
RUN groupadd --gid 10001 metronome \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app --shell /usr/sbin/nologin metronome \
    && mkdir -p /registry /app/data && chown -R metronome:metronome /registry /app
USER metronome

CMD ["sh", "-c", "metronome worker --registry \"$METRONOME_REGISTRY\" --api-url \"$METRONOME_API_URL\" --threads 1"]
